  "cards": [
    {
      "dot": "violet",
      "title": "Read the demo correctly",
      "items": [
        "Client, speaker identity and phone view are simulated.",
        "Backend checks run; connected tools are mock actions.",
        "The optional local hub is a separate implementation path."
      ]
    },
    {
      "dot": "emerald",
      "title": "Approval boundary",
      "items": [
        "Sensitive requests wait for the owner.",
        "Continuations check household, tool and argument hash.",
        "Expired or already-used approvals are rejected."
      ]
    },
    {
      "dot": "amber",
      "title": "Separate AWS reporting path",
      "items": [
        "Owner export file feeds an explicit on-demand CLI invocation.",
        "Raw utterances, audio and tokens are excluded before upload.",
        "Reports are advisory; they cannot authorise tool execution."
      ]
    }
